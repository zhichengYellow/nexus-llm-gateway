# ===== 服务 =====
PORT=8787
LOG_LEVEL=info
# 网关管理用主密钥（用于调用管理 API、生成租户 Key）
GATEWAY_MASTER_KEY=sk-nexus-master-change-me

# ===== 数据库（Postgres + pgvector）=====
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus

# ===== Redis（限流 / 缓存）=====
REDIS_URL=redis://localhost:6379

# ===== 语义缓存 =====
# 相似度阈值（0~1），越高越严格；建议 0.95~0.98
SEMANTIC_CACHE_THRESHOLD=0.95
# 缓存 TTL（秒）
SEMANTIC_CACHE_TTL=86400
# 缓存用的 embedding 模型（由哪个 provider 提供）
SEMANTIC_CACHE_EMBEDDING_MODEL=text-embedding-3-small

# ===== Provider: DeepSeek =====
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ===== Provider: Ollama（本地）=====
OLLAMA_BASE_URL=http://localhost:11434
# Ollama 无需 API Key，留空即可
OLLAMA_API_KEY=

# ===== Provider: OpenAI（可选，用于 embedding）=====
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# ===== Provider: Qwen 通义千问（OpenAI 兼容）=====
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

# ===== Provider: Moonshot Kimi（OpenAI 兼容）=====
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=

# ===== Provider: Zhipu 智谱 GLM（OpenAI 兼容）=====
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=

# ===== Provider: Gemini（OpenAI 兼容端点）=====
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=

# ===== Provider 代理（国内访问 OpenAI / Gemini 等海外 API）=====
# 格式：<PROVIDER_TYPE>_PROXY=http://127.0.0.1:<代理端口>
# 仅配置了代理的 Provider 走代理，其余直连；支持 Clash/V2Ray/任意 HTTP 代理
GEMINI_PROXY=http://127.0.0.1:7897
# OPENAI_PROXY=http://127.0.0.1:7897   # 如 OpenAI 也需要代理则取消注释
# QWEN_PROXY=
# MOONSHOT_PROXY=
# ZHIPU_PROXY=

# ===== v2.0 优化开关（Token / Cost / Quality）=====
# Prompt Compression 总开关（礼貌语删除 + System Prompt 去重）
COMPRESSION_ENABLED=true
# 对话压缩保留最近轮数（默认 2）
CONVERSATION_COMPRESS_KEEP_RECENT=2
# 摘要覆盖最大轮数（默认 18）
CONVERSATION_COMPRESS_MAX_SUMMARY_ROUNDS=18
# 动态上下文开关（问候语/继续/引用检测）
ADAPTIVE_CONTEXT_ENABLED=true
# Chunk 级缓存开关
CHUNK_CACHE_ENABLED=true
# 缓存门控高置信度阈值（≥此值直接返回）
CACHE_GATE_CONFIDENCE_HIGH=0.9
# 缓存门控低置信度阈值（<此值重新生成）
CACHE_GATE_CONFIDENCE_LOW=0.7
# 智能路由开关（model=auto 时启用 SmartRoutingEngine）
SMART_ROUTING_ENABLED=true
# 预算封锁阈值（0~1，usageRate 超过则 block 请求）
BUDGET_BLOCK_THRESHOLD=1.0
# 预算降级阈值（0~1，超过则仅用便宜模型）
BUDGET_CHEAP_ONLY_THRESHOLD=0.8
# 响应质量评估开关（false 避免额外延迟）
QUALITY_JUDGE_ENABLED=false
# TRR/CSR/QPS 指标采集开关
OPTIMIZE_METRICS_ENABLED=true

# ===== 凭据加密 =====
# Provider API Key 静态加密密钥（AES-256-GCM）。
# 生产环境必填（缺失将拒绝保存 provider key）；本地开发可留空（使用内置 dev 密钥，仅限本地）。
# 可用: 64 位 hex（openssl rand -hex 32）或任意字符串（自动 SHA-256 派生）。
# ENCRYPTION_KEY=
