{
  "name": "nexus-llm-gateway",
  "version": "2.2.0",
  "private": false,
  "type": "module",
  "description": "Nexus LLM Gateway - AI Cost Optimization Platform. OpenAI-compatible API gateway with prompt compression, semantic cache, smart routing, and budget control. Save 30-80% on LLM costs.",
  "main": "dist/server/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/server/index.js",
    "./server": "./dist/server/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bran-huang/nexus-llm-gateway"
  },
  "license": "MIT",
  "publishConfig": {
    "private": true
  },
  "bin": {
    "nexus-cli": "./cli/nexus-cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --env-file=.env src/server/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "ioredis": "^5.4.2",
    "nanoid": "^5.0.9",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "undici": "^8.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
