# ===== 生产环境配置 =====
# 复制为 .env.production 并修改

# 服务
PORT=8787
LOG_LEVEL=info
NODE_ENV=production
# ⚠️ 生产环境务必改为随机强密钥
GATEWAY_MASTER_KEY=sk-nexus-master-CHANGE-THIS-TO-RANDOM

# 数据库（生产环境用强密码）
DATABASE_URL=postgres://nexus:CHANGE_PASSWORD@postgres:5432/nexus

# Redis
REDIS_URL=redis://redis:6379

# 语义缓存
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL=86400
SEMANTIC_CACHE_EMBEDDING_MODEL=text-embedding-3-small

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Ollama（生产环境如不需要可留空）
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=

# OpenAI（用于 embedding）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-key
# ===== Provider 代理（国内无法直连的 Provider 走本地代理）=====
# 格式：<PROVIDER_TYPE>_PROXY=http://127.0.0.1:<端口>
# 仅配置了代理的 Provider 会走代理，其余直连不受影响
# 支持 Clash / V2Ray / SS 等任何 HTTP 代理
GEMINI_PROXY=http://127.0.0.1:7897
# OPENAI_PROXY=http://127.0.0.1:7897
# QWEN_PROXY=
# MOONSHOT_PROXY=
# ZHIPU_PROXY=
