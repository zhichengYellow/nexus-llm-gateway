# Nexus LLM Gateway - Nginx 反向代理配置
# 部署到服务器时使用，提供 SSL 终止、域名绑定、限流

upstream nexus_gateway {
    server 127.0.0.1:8787;
    keepalive 64;
}

# HTTP → HTTPS 重定向
server {
    listen 80;
    server_name gateway.yourdomain.com;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name gateway.yourdomain.com;

    # SSL 证书（使用 certbot / acme.sh 申请）
    ssl_certificate     /etc/letsencrypt/live/gateway.yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gateway.yourdomain.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # 请求体大小限制（根据实际需求调整）
    client_max_body_size 10m;

    # 代理到网关
    location / {
        proxy_pass http://nexus_gateway;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 流式响应支持
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;

        # 超时设置
        proxy_connect_timeout 60s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
    }

    # 健康检查端点（无需认证）
    location /health {
        proxy_pass http://nexus_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }

    # 限制管理 API 访问来源 IP（可选）
    location /admin {
        proxy_pass http://nexus_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # allow 你的管理IP;
        # deny all;
    }
}